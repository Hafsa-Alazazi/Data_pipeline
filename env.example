# Copy this file to ".env" (same folder) and adjust if needed:
#     cp example.env .env        (Windows CMD: copy example.env .env)
# Every variable is OPTIONAL: the shown values are the defaults used when it is missing.
# No real credentials belong in this file.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=midterm_pipeline

# --- Midterm pipeline ---
SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=5000
CSV_ENCODING=utf-8-sig
SPARK_MASTER=local[*]

# --- Final project: scheduled jobs ---
# Start the background scheduler together with the API (true/false)
ENABLE_SCHEDULER=true
# Job 1: refresh_materialized_views runs every N minutes
JOB_REFRESH_MV_EVERY_MINUTES=15
# Job 2: periodic_report runs daily at this time
JOB_REPORT_HOUR=2
JOB_REPORT_MINUTE=0
JOBS_TIMEZONE=UTC
